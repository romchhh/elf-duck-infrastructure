# Admin UI login (Docker/root .env usually owns these)
TEGGER_ADMIN_USERNAME=admin
TEGGER_ADMIN_PASSWORD=
# Prefer password above; avoid raw $argon2 hash in compose .env

FRONTEND_ORIGIN=http://localhost:5173
DRY_RUN=true
TEGGER_BOOTSTRAP=true

# Limits (optional; also editable in UI Settings)
MAX_CONCURRENT_SENDERS=3
TARGETS_PER_SENDER_PER_DAY=14
TARGETS_PER_STORY_MIN=2
TARGETS_PER_STORY_MAX=3
STORY_INTERVAL_MIN_SECONDS=900
STORY_INTERVAL_MAX_SECONDS=1124
INTERACTION_STORY_DELAY=20

# Optional log bot (also editable in UI Settings)
LOG_BOT_TOKEN=
LOG_CHAT_ID=

# Telegram API ID / Hash / senders — NOT here.
# Set in Tegger UI: Settings (API ID/Hash) → Accounts (phone login or .session import).
