# ELF DUCK — єдиний .env (корінь elf-duck-shop)
# cp .env.example .env

# =============================================================================
# Production — telebots.site (VPS / Docker)
# =============================================================================
# APP_URL=https://elfduck.telebots.site
# WEBAPP_URL=https://elfduck.telebots.site
# WEB_APP_URL=https://elfduck.telebots.site
# VITE_API_URL=https://elfduck-api.telebots.site
# VITE_CRM_API_URL=https://elfduck-api.telebots.site
# CRM_ALLOWED_ORIGINS=https://elfduck-crm.telebots.site
# API_URL=https://elfduck-api.telebots.site
# NODE_ENV=production

# =============================================================================
# Local dev (або Docker на localhost)
# =============================================================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3001
WEBAPP_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3001
VITE_API_URL=http://localhost:3000
VITE_CRM_API_URL=http://localhost:3000
CRM_ALLOWED_ORIGINS=http://localhost:3002
API_URL=http://localhost:3000

# --- Database ---
# Prod Atlas: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/elfduck
# Local Docker: mongodb://localhost:3004/elfduck
MONGODB_URI=mongodb://localhost:3004/elfduck

# --- Telegram main bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Admin API & CRM ---
ADMIN_API_TOKEN=
ADMIN_IDS=
SUPER_ADMIN_IDS=
CRM_ADMIN_PASSWORD=
CRM_SESSION_SECRET=

# --- Admin Telegram bot ---
ADMIN_BOT_TOKEN=

# --- Cart / orders ---
CART_AUTO_CLEAR_AFTER_MINUTES=10
CART_AUTO_CLEAR_INTERVAL_MS=60000
ORDER_PAYMENT_CONFIRM_TIMEOUT_MINUTES=
FREE_COURIER_DELIVERY_THRESHOLD_ZL=
CLEAR_ALL_RESERVED_QTY_ON_STARTUP=

# --- Google Sheets webhooks (URL мають вказувати на elfduck-api.telebots.site) ---
GOOGLE_STATS_WEBHOOK_URL=
GOOGLE_STATS_WEBHOOK_URL_PRAGA=
GOOGLE_STATS_WEBHOOK_URL_MOKOTOW=
GOOGLE_STATS_WEBHOOK_URL_WOLA=
GOOGLE_STATS_WEBHOOK_URL_SRODMIESCIE=
GOOGLE_STATS_WEBHOOK_URL_COURIER=
GOOGLE_STATS_WEBHOOK_URL_INPOST=

# --- Telegram order photo chats ---
TG_ORDER_PHOTO_PRAGA=
TG_ORDER_PHOTO_MOKOTOW=
TG_ORDER_PHOTO_WOLA=
TG_ORDER_PHOTO_SRODMIESCIE=
TG_ORDER_PHOTO_COURIER=
TG_ORDER_PHOTO_INPOST=
TG_CLIENT_ORDER_PHOTO_PRAGA=
TG_CLIENT_ORDER_PHOTO_MOKOTOW=
TG_CLIENT_ORDER_PHOTO_WOLA=
TG_CLIENT_ORDER_PHOTO_SRODMIESCIE=
TG_CLIENT_ORDER_PHOTO_COURIER=
TG_CLIENT_ORDER_PHOTO_INPOST=

START_BANNER_URL=
